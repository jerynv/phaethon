{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: the app's own commands, plus only the window calls the custom title bar needs (drag, double-click to maximize, and the minimize / maximize / close buttons drawn on Windows and Linux). No menu/tray/path APIs, no plugins; add a permission only when a feature needs it.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-dev-log",
    "allow-agent-send",
    "allow-agent-cancel",
    "allow-agent-approve",
    "allow-thread-load",
    "allow-settings-get",
    "allow-settings-set-backend",
    "allow-api-key-set",
    "allow-api-key-clear",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "allow-appearance-set",
    "allow-agent-access-answer",
    "allow-grants-list",
    "allow-grant-revoke",
    "allow-spaces-list",
    "allow-space-create",
    "allow-space-update"
  ]
}
