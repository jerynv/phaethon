{
  "name": "phaethon",
  "productName": "Phaethon",
  "private": true,
  "version": "0.2.0",
  "description": "An accessible, desktop-first AI agent workspace.",
  "license": "MIT",
  "author": "Jeryn Vicari",
  "homepage": "https://github.com/jerynv/phaethon",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "imports": {
    "#shared/*": "./src/shared/*"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:web && pnpm build:node",
    "build:web": "vite build",
    "build:node": "node scripts/build-node.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:ui": "pnpm build && playwright test",
    "core": "node dist/server/main.mjs",
    "desktop": "electron .",
    "dist": "pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@napi-rs/canvas": "^0.1.80",
    "@napi-rs/keyring": "^1.2.0",
    "@seydx/win-job": "0.1.0",
    "@tesseract.js-data/eng": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "cross-spawn": "7.0.6",
    "docx-preview": "0.4.1",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.2",
    "katex": "^0.19.0",
    "lucide-react": "0.564.0",
    "mermaid": "^12.1.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.13.0",
    "tailwind-merge": "^3.4.0",
    "tesseract.js": "^6.0.1",
    "ws": "^8.18.3",
    "zod": "^4.1.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "44.10.1",
    "electron-builder": "26.16.1",
    "esbuild": "^0.25.10",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "overrides": {
      "wasm-feature-detect": "1.8.0"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@napi-rs/canvas",
      "@napi-rs/keyring"
    ]
  }
}
