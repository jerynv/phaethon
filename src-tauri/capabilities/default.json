{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: the app's own commands, plus only the window calls the custom title bar needs (drag, double-click to maximize, the minimize / maximize / close buttons drawn on Windows and Linux, and the window title naming the space). No menu/tray/path APIs, no plugins; add a permission only when a feature needs it.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-dev-log",
    "allow-agent-send",
    "allow-agent-cancel",
    "allow-agent-approve",
    "allow-thread-load",
    "allow-thread-new",
    "allow-threads-list",
    "allow-thread-open",
    "allow-settings-get",
    "allow-settings-set-backend",
    "allow-api-key-set",
    "allow-api-key-clear",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "allow-appearance-set",
    "allow-agent-access-answer",
    "allow-grants-list",
    "allow-grant-revoke",
    "allow-spaces-list",
    "allow-space-create",
    "allow-space-update",
    "allow-space-model-get",
    "allow-space-model-set",
    "allow-space-models-list",
    "allow-api-key-check",
    "allow-models-list",
    "allow-settings-set-model",
    "allow-file-open",
    "allow-grant-restore",
    "allow-thread-delete",
    "allow-claude-cli-status",
    "allow-thread-clear",
    "allow-thread-forget",
    "allow-thread-forget-preview",
    "allow-space-touch",
    "allow-space-show",
    "allow-space-export",
    "allow-export-show",
    "allow-conversations-search"
  ]
}
